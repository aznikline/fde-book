---
import { getCollection } from 'astro:content';
import { renderMarkdownWithToc } from '../lib/render-md';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getCollection('handbook')).find(
  (e) => e.id === 'fde-handbook.md' || e.id === 'fde-handbook' || e.id.endsWith('/fde-handbook.md'),
);
const body = entry?.body ?? '';
const { html, toc } = await renderMarkdownWithToc(body);

// 手册正文用 ❗ 标记高危信号/红线，它是 emoji 字符、跨平台渲染风格不一，
// 统一替换为排版稳定的几何符号 ▲（文本渲染，非 emoji）。
const renderedHtml = html.replace(/❗/g, '▲');
---

<BaseLayout title="工作手册" activeSlug="handbook">
  <article class="handbook">
    <header class="handbook-head">
      <p class="eyebrow">可执行检查清单</p>
      <h1>FDE 工作手册</h1>
      <p class="lead">
        全书方法论整理成一份按交付旅程排的检查清单。
        每个阶段含核心信条、决策清单、高危信号（▲）、阈值和关键产出物。
        方括号是可勾选项；带 ▲ 的是书里标过的高危信号或红线。
      </p>
    </header>

    {
      toc.length > 0 && (
        <nav class="handbook-toc" aria-label="手册目录">
          <p class="toc-title">目录</p>
          <ul>
            {toc.map((t) => (
              <li><a href={`#${t.id}`}>{t.text}</a></li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="handbook-body" set:html={renderedHtml} />
  </article>
</BaseLayout>

<style is:global>
  .handbook { max-width: 50rem; }
  .handbook-head { margin-bottom: 2.25rem; }
  .eyebrow {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--c-accent); font-weight: 700; margin: 0 0 0.6rem;
  }
  .handbook-head h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.6rem);
    font-weight: 700; margin: 0 0 0.85rem; letter-spacing: 0.01em;
  }
  .handbook-head .lead {
    font-size: 0.95rem; color: var(--text-soft);
    line-height: 1.85; margin: 0; max-width: 42rem;
  }
  .handbook-toc {
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
    margin-bottom: 2.5rem;
  }
  .handbook-toc .toc-title {
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--text-soft); margin: 0 0 0.55rem;
  }
  .handbook-toc ul {
    list-style: none; padding: 0; margin: 0;
    columns: 2; column-gap: 1.75rem;
  }
  .handbook-toc li { margin: 0.25rem 0; break-inside: avoid; }
  .handbook-toc a { font-size: 0.85rem; color: var(--text); }
  .handbook-toc a:hover { color: var(--c-accent); }
  @media (max-width: 600px) { .handbook-toc ul { columns: 1; } }

  .handbook-body { font-size: 0.925rem; line-height: 1.85; }
  .handbook-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.35rem; font-weight: 700; margin: 2.75rem 0 1rem;
    padding-top: 1.6rem; border-top: 1px solid var(--border);
    letter-spacing: 0.01em;
    scroll-margin-top: 4.5rem;
  }
  .handbook-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.08rem; font-weight: 700; margin: 1.9rem 0 0.65rem;
    scroll-margin-top: 4.5rem;
  }
  .handbook-body :global(h4) {
    font-size: 0.95rem; font-weight: 700; margin: 1.3rem 0 0.5rem;
    color: var(--c-accent-deep);
  }
  .handbook-body :global(p) { margin: 0 0 0.9rem; }
  .handbook-body :global(blockquote) {
    border-left: 3px solid var(--c-accent);
    padding: 0.55rem 1.1rem; margin: 1.1rem 0;
    color: var(--text-soft); background: var(--bg-sidebar);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0; font-size: 0.88rem;
  }
  .handbook-body :global(ul), .handbook-body :global(ol) {
    margin: 0 0 1rem; padding-left: 1.6rem;
  }
  .handbook-body :global(li) { margin: 0.4rem 0; }
  .handbook-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em; background: var(--bg-code);
    border: 1px solid var(--border);
    padding: 0.1em 0.35em; border-radius: 4px;
  }
  .handbook-body :global(pre) {
    background: var(--bg-sidebar); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 1rem; overflow-x: auto;
    font-size: 0.8rem; line-height: 1.65;
  }
  .handbook-body :global(pre code) {
    background: none; border: none; padding: 0; font-size: inherit;
  }
  .handbook-body :global(table) {
    width: 100%; border-collapse: collapse; margin: 1rem 0;
    font-size: 0.85rem;
  }
  .handbook-body :global(th), .handbook-body :global(td) {
    border: 1px solid var(--border); padding: 0.55rem 0.8rem; text-align: left;
  }
  .handbook-body :global(th) {
    background: var(--bg-sidebar); font-weight: 700;
  }
  .handbook-body :global(strong) { font-weight: 700; }
  .handbook-body :global(hr) {
    border: none; border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  /* 高危信号 ▲ 标记：警示色，行内醒目但不喧宾夺主 */
  .handbook-body :global(li), .handbook-body :global(p) {
    color: var(--text);
  }
</style>
