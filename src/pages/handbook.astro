---
import { getCollection } from 'astro:content';
import { renderMarkdownWithToc } from '../lib/render-md';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getCollection('handbook')).find(
  (e) => e.id === 'fde-handbook.md' || e.id === 'fde-handbook' || e.id.endsWith('/fde-handbook.md'),
);
const body = entry?.body ?? '';
const { html, toc } = await renderMarkdownWithToc(body);

// 手册正文用 ❗ 标记高危信号/红线，它是 emoji 字符、跨平台渲染风格不一，
// 统一替换为排版稳定的几何符号 ▲（文本渲染，非 emoji）。
const renderedHtml = html.replace(/❗/g, '▲');
---

<BaseLayout title="工作手册" activeSlug="handbook">
  <article class="handbook">
    <header class="handbook-head">
      <p class="eyebrow">可执行检查清单</p>
      <h1>FDE 工作手册</h1>
      <p class="lead">
        全书方法论整理成一份按交付旅程排的检查清单。
        每个阶段含核心信条、决策清单、高危信号（▲）、阈值和关键产出物。
        方括号是可勾选项；带 ▲ 的是书里标过的高危信号或红线。
      </p>
    </header>

    {
      toc.length > 0 && (
        <nav class="handbook-toc" aria-label="手册目录">
          <p class="toc-title">目录</p>
          <ul>
            {toc.map((t) => (
              <li><a href={`#${t.id}`}>{t.text}</a></li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="handbook-body" set:html={renderedHtml} />
  </article>
</BaseLayout>

<style is:global>
  .handbook { max-width: 44rem; }
  .handbook-head { margin-bottom: 2rem; }
  .eyebrow {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--text-soft); margin: 0 0 0.5rem;
  }
  .handbook-head h1 {
    font-size: 1.8rem;
    font-weight: 400; margin: 0 0 0.3rem;
    color: var(--text-strong);
  }
  .handbook-head .lead {
    font-size: 1rem; color: var(--text-soft);
    line-height: 1.75; margin: 0.5rem 0 0; max-width: 42rem;
  }
  .handbook-toc {
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 2rem;
    font-size: 0.92rem;
  }
  .handbook-toc .toc-title {
    font-size: 0.72rem; font-weight: 400; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--text-soft); margin: 0 0 0.5rem;
  }
  .handbook-toc ul {
    list-style: none; padding: 0; margin: 0;
    columns: 2; column-gap: 1.75rem;
  }
  .handbook-toc li { margin: 0.25rem 0; break-inside: avoid; }
  .handbook-toc a { font-size: 0.88rem; color: var(--text); }
  .handbook-toc a:hover { color: var(--c-accent); }
  @media (max-width: 600px) { .handbook-toc ul { columns: 1; } }

  .handbook-body { font-size: 0.98rem; line-height: 1.75; }
  .handbook-body :global(h2) {
    font-size: 1.3rem; font-weight: 400; margin: 2.4rem 0 0.9rem;
    color: var(--text-strong);
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 0.3rem;
    scroll-margin-top: 4.5rem;
  }
  .handbook-body :global(h3) {
    font-size: 1.1rem; font-weight: 400; margin: 1.8rem 0 0.6rem;
    color: var(--text-strong);
    scroll-margin-top: 4.5rem;
  }
  .handbook-body :global(h4) {
    font-size: 0.98rem; font-weight: 400; margin: 1.2rem 0 0.5rem;
    color: var(--text-strong);
  }
  .handbook-body :global(p) { margin: 0.9rem 0; }
  .handbook-body :global(blockquote) {
    margin: 0.9rem 0;
    padding-left: 1.2rem;
    border-left: 3px solid var(--border);
    color: var(--text-soft);
    font-size: 0.95rem;
  }
  .handbook-body :global(ul), .handbook-body :global(ol) {
    margin: 0.9rem 0; padding-left: 1.4rem;
  }
  .handbook-body :global(li) { margin: 0.3rem 0; }
  .handbook-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em; background: var(--bg-code);
    border-radius: 2px;
    padding: 0.08rem 0.3rem;
  }
  .handbook-body :global(pre) {
    background: var(--bg-code); border: 1px solid var(--border-soft);
    border-radius: 2px; padding: 1rem; overflow-x: auto;
    font-size: 0.86rem; line-height: 1.65;
  }
  .handbook-body :global(pre code) {
    background: none; padding: 0; font-size: inherit;
  }
  .handbook-body :global(table) {
    width: 100%; border-collapse: collapse; margin: 0.9rem 0;
    font-size: 0.88rem;
  }
  .handbook-body :global(th), .handbook-body :global(td) {
    border: 1px solid var(--border); padding: 0.35rem 0.65rem; text-align: left;
  }
  .handbook-body :global(th) {
    font-weight: 400; color: var(--text-soft); background: var(--bg-sidebar);
  }
  .handbook-body :global(strong) { color: var(--text-strong); }
  .handbook-body :global(hr) {
    border: none; border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
</style>
