---
import { getCollection } from 'astro:content';
import { renderMarkdownWithToc } from '../lib/render-md';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getCollection('handbook')).find(
  (e) => e.id === 'fde-handbook.md' || e.id === 'fde-handbook' || e.id.endsWith('/fde-handbook.md'),
);
const body = entry?.body ?? '';
const { html, toc } = await renderMarkdownWithToc(body);
---

<BaseLayout title="工作手册" activeSlug="handbook">
  <article class="handbook">
    <header class="handbook-head">
      <p class="eyebrow">可执行检查清单</p>
      <h1>FDE 工作手册</h1>
      <p class="lead">
        把《前线部署工程师》全书方法论提炼为按交付旅程组织的检查清单。
        每一阶段含核心信条、决策清单、高危信号(❗)、阈值标准与关键产出物。
        方括号可勾选；带 ❗ 为书中明确的高危信号或红线。
      </p>
    </header>

    {
      toc.length > 0 && (
        <nav class="handbook-toc" aria-label="手册目录">
          <p class="toc-title">目录</p>
          <ul>
            {toc.map((t) => (
              <li><a href={`#${t.id}`}>{t.text}</a></li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="handbook-body" set:html={html} />
  </article>
</BaseLayout>

<style is:global>
  .handbook { max-width: 50rem; }
  .handbook-head { margin-bottom: 2rem; }
  .eyebrow {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--c-accent); font-weight: 700; margin: 0 0 0.5rem;
  }
  .handbook-head h1 {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 800; margin: 0 0 0.75rem; letter-spacing: -0.01em;
  }
  .handbook-head .lead {
    font-size: 0.95rem; color: var(--text-soft);
    line-height: 1.7; margin: 0; max-width: 40rem;
  }
  .handbook-toc {
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
  }
  .handbook-toc .toc-title {
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--text-soft); margin: 0 0 0.5rem;
  }
  .handbook-toc ul {
    list-style: none; padding: 0; margin: 0;
    columns: 2; column-gap: 1.5rem;
  }
  .handbook-toc li { margin: 0.2rem 0; break-inside: avoid; }
  .handbook-toc a { font-size: 0.85rem; color: var(--text); }
  .handbook-toc a:hover { color: var(--c-accent); }
  @media (max-width: 600px) { .handbook-toc ul { columns: 1; } }

  .handbook-body { font-size: 0.9rem; line-height: 1.7; }
  .handbook-body :global(h2) {
    font-size: 1.3rem; font-weight: 800; margin: 2.5rem 0 1rem;
    padding-top: 1.5rem; border-top: 2px solid var(--border);
    letter-spacing: -0.01em;
    scroll-margin-top: 4rem;
  }
  .handbook-body :global(h3) {
    font-size: 1.05rem; font-weight: 700; margin: 1.75rem 0 0.6rem;
    scroll-margin-top: 4rem;
  }
  .handbook-body :global(h4) {
    font-size: 0.95rem; font-weight: 700; margin: 1.25rem 0 0.5rem;
    color: var(--c-accent-deep);
  }
  .handbook-body :global(p) { margin: 0 0 0.85rem; }
  .handbook-body :global(blockquote) {
    border-left: 3px solid var(--c-accent);
    padding: 0.5rem 1rem; margin: 1rem 0;
    color: var(--text-soft); background: var(--bg-sidebar);
    border-radius: 0 6px 6px 0; font-size: 0.85rem;
  }
  .handbook-body :global(ul), .handbook-body :global(ol) {
    margin: 0 0 1rem; padding-left: 1.5rem;
  }
  .handbook-body :global(li) { margin: 0.35rem 0; }
  .handbook-body :global(code) {
    font-family: ui-monospace, 'SF Mono', Consolas, monospace;
    font-size: 0.85em; background: var(--border);
    padding: 0.1em 0.35em; border-radius: 4px;
  }
  .handbook-body :global(pre) {
    background: var(--bg-sidebar); border: 1px solid var(--border);
    border-radius: 8px; padding: 1rem; overflow-x: auto;
    font-size: 0.8rem; line-height: 1.6;
  }
  .handbook-body :global(pre code) {
    background: none; padding: 0; font-size: inherit;
  }
  .handbook-body :global(table) {
    width: 100%; border-collapse: collapse; margin: 1rem 0;
    font-size: 0.85rem;
  }
  .handbook-body :global(th), .handbook-body :global(td) {
    border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left;
  }
  .handbook-body :global(th) {
    background: var(--bg-sidebar); font-weight: 700;
  }
  .handbook-body :global(strong) { font-weight: 700; }
  .handbook-body :global(hr) {
    border: none; border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
</style>
