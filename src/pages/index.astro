---
import BaseLayout from '../layouts/BaseLayout.astro';
import { chapters, titles } from '../lib/chapters';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="首页">
  <section class="hero">
    <h1 class="hero-title">前线部署工程师</h1>
    <p>人工智能时代的客户价值交付秘籍。</p>
    <p>范冰著 · 免费公开全文 · 中英逐段对照阅读版，附一份可勾选的工作手册。</p>
    <div class="hero-cta">
      <a href={`${base}chapters/chapter-1-rise-of-fde/`}>开始阅读 →</a>
      <a href={`${base}handbook/`}>查看工作手册</a>
    </div>
  </section>

  <section class="stats">
    <div class="stat"><span class="n">12</span><span class="l">章节</span></div>
    <div class="stat"><span class="n">120</span><span class="l">真实案例</span></div>
    <div class="stat"><span class="n">6</span><span class="l">交付阶段</span></div>
  </section>

  <section>
    <h2 class="section-title">章节目录</h2>
    <div class="cards">
      {
        chapters.map((slug, i) => (
          <a class="card" href={`${base}chapters/${slug}/`}>
            <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="card-title">{titles[slug]}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="section-title">本站提供</h2>
    <div class="cards">
      <a class="card feature" href={`${base}chapters/chapter-1-rise-of-fde/`}>
        <h3>中英对照原文</h3>
        <p class="zh">逐段并排，中文在左、英文在右，移动端自动堆叠。精读和术语对照都方便。</p>
      </a>
      <a class="card feature" href={`${base}handbook/`}>
        <h3>可执行工作手册</h3>
        <p class="zh">全书方法论整理成按交付旅程排的检查清单，每项带阈值与高危信号。</p>
      </a>
      <a class="card feature" href={`${base}metrics/`}>
        <h3>指标速查</h3>
        <p class="zh">FDE 全流程指标一页纸：TTV、NRR、毛利率、转化率，每项附参考线与警戒线。</p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 1.5rem 0 0.5rem; border-bottom: 1px solid var(--border-soft); margin-bottom: 1.2rem; }
  .hero-title {
    font-size: 2.6rem;
    font-weight: 400;
    margin: 0 0 0.6rem;
    color: var(--text-strong);
    line-height: 1.15;
    letter-spacing: 0.01em;
  }
  .hero p { color: var(--text-soft); margin: 0.25rem 0; font-size: 1.05rem; }
  .hero-cta { margin-top: 1.2rem; display: flex; gap: 1.4rem; flex-wrap: wrap; }
  .hero-cta a {
    border: 1px solid var(--border);
    background: var(--bg);
    border-radius: 2px;
    padding: 0.3rem 1.1rem;
    font-size: 0.95rem;
    color: var(--text);
  }
  .hero-cta a:hover { border-color: var(--c-accent); color: var(--c-accent); text-decoration: none; }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--border-soft);
    border: 1px solid var(--border-soft);
    margin: 1.2rem 0;
  }
  .stat { background: var(--bg); padding: 1.1rem 1.2rem; }
  .stat .n { font-size: 2rem; line-height: 1.1; color: var(--text-strong); font-variant-numeric: oldstyle-nums; }
  .stat .l { font-size: 0.82rem; color: var(--text-soft); margin-top: 0.2rem; }

  .section-title {
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin: 2.8rem 0 1.2rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 0.5rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1px;
    background: var(--border-soft);
    border: 1px solid var(--border-soft);
  }
  .card {
    background: var(--bg);
    padding: 1.1rem 1.3rem;
    display: block;
    color: var(--text);
  }
  .card:hover { background: var(--bg-sidebar); text-decoration: none; }
  .card-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-soft);
    margin-right: 0.7rem;
  }
  .card-title { font-size: 1.02rem; color: var(--text-strong); }
  .feature h3 { margin: 0 0 0.2rem; font-size: 1.05rem; font-weight: 400; color: var(--text-strong); }
  .feature .zh { color: var(--text-soft); font-size: 0.92rem; margin: 0; }
</style>
