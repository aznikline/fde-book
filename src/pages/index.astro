---
import BaseLayout from '../layouts/BaseLayout.astro';
import { chapters, titles } from '../lib/chapters';
---

<BaseLayout title="首页">
  <section class="hero">
    <p class="hero-eyebrow">中英对照阅读 · 工作手册</p>
    <h1 class="hero-title">前线部署工程师</h1>
    <p class="hero-sub">
      人工智能时代的客户价值交付秘籍。<br />
      范冰著 · 免费公开全文 · 此站提供中英逐段对照阅读与可执行工作手册。
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="/chapters/chapter-1-rise-of-fde/">
        开始阅读 →
      </a>
      <a class="btn btn-ghost" href="/handbook/">查看工作手册</a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">12</span>
        <span class="stat-label">章节</span>
      </div>
      <div class="stat">
        <span class="stat-num">120</span>
        <span class="stat-label">真实案例</span>
      </div>
      <div class="stat">
        <span class="stat-num">6</span>
        <span class="stat-label">交付阶段</span>
      </div>
    </div>
  </section>

  <section class="chapter-list">
    <h2 class="section-title">章节目录</h2>
    <ol class="toc">
      {
        chapters.map((slug, i) => (
          <li>
            <a href={`/chapters/${slug}/`}>
              <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="toc-title">{titles[slug]}</span>
              <span class="toc-arrow">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="features">
    <h2 class="section-title">本站提供</h2>
    <div class="feature-grid">
      <a class="feature" href="/chapters/chapter-1-rise-of-fde/">
        <h3>中英对照原文</h3>
        <p>逐段并排阅读，中文在左、英文在右，移动端自动堆叠。便于精读与术语对照。</p>
      </a>
      <a class="feature" href="/handbook/">
        <h3>可执行工作手册</h3>
        <p>把全书方法论提炼为按交付旅程组织的检查清单，每项带阈值与高危信号，可直接落地。</p>
      </a>
      <a class="feature" href="/metrics/">
        <h3>指标速查</h3>
        <p>FDE 全链路指标体系一页纸：TTV、NRR、毛利率、转化率——每项附参考标准与警戒线。</p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 1.5rem 0 1.5rem;
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: 2.5rem;
  }
  .hero-eyebrow {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 0 0.8rem;
    font-family: var(--sans);
  }
  .hero-title {
    font-size: clamp(2.4rem, 1rem + 7vw, 3.8rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    margin: 0 0 0.9rem;
    line-height: 1.12;
    color: var(--fg-strong);
  }
  .hero-sub {
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.1rem);
    color: var(--muted);
    margin: 0 0 1.8rem;
    line-height: 1.7;
    max-width: 38rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.4rem;
    font-weight: 400;
    font-size: 0.95rem;
    font-family: var(--serif);
    border: 1px solid var(--border);
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .btn:hover { text-decoration: none; transform: none; }
  .btn-primary {
    background: var(--fg-strong);
    color: #fff;
    border-color: var(--fg-strong);
  }
  .btn-primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn-ghost {
    background: transparent;
    color: var(--fg);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hero-stats {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border-soft);
    padding-top: 1.5rem;
  }
  .stat { display: flex; flex-direction: column; }
  .stat-num {
    font-size: 2rem;
    font-weight: 400;
    color: var(--fg-strong);
    line-height: 1.1;
    font-variant-numeric: oldstyle-nums;
  }
  .stat-label {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.3rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--sans);
  }

  .chapter-list, .features {
    max-width: 50rem;
    margin: 0 0 2.5rem;
  }
  .section-title {
    font-size: 0.78rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 0 1.3rem;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 0.5rem;
    font-family: var(--sans);
  }
  .toc {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border-soft);
  }
  .toc li a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    color: var(--fg);
    border-bottom: 1px solid var(--border-soft);
    transition: background 0.12s, color 0.12s;
  }
  .toc li:last-child a { border-bottom: none; }
  .toc li a:hover {
    background: var(--bg-side);
    text-decoration: none;
    color: var(--accent);
  }
  .toc-num {
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: oldstyle-nums;
    min-width: 1.5rem;
    font-family: var(--mono);
  }
  .toc-title { flex: 1; font-weight: 400; }
  .toc-arrow {
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.12s, transform 0.12s;
  }
  .toc li a:hover .toc-arrow { opacity: 1; transform: translateX(3px); }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--border-soft);
    border: 1px solid var(--border-soft);
  }
  .feature {
    display: block;
    padding: 1.4rem 1.5rem;
    color: var(--fg);
    background: var(--bg);
    transition: background 0.12s, color 0.12s;
  }
  .feature:hover {
    text-decoration: none;
    background: var(--bg-side);
    color: var(--accent);
  }
  .feature h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--fg-strong);
  }
  .feature:hover h3 { color: var(--accent); }
  .feature p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.65;
  }
</style>
