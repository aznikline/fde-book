---
import BaseLayout from '../layouts/BaseLayout.astro';
import { chapters, titles } from '../lib/chapters';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="首页">
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">中英对照阅读 · 工作手册</p>
      <h1 class="hero-title">前线部署工程师</h1>
      <p class="hero-sub">
        人工智能时代的客户价值交付秘籍。<br />
        范冰著 · 免费公开全文 · 这里是中英逐段对照阅读版，附一份可勾选的工作手册。
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}chapters/chapter-1-rise-of-fde/`}>
          开始阅读 →
        </a>
        <a class="btn btn-ghost" href={`${base}handbook/`}>查看工作手册</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">12</span>
          <span class="stat-label">章节</span>
        </div>
        <div class="stat">
          <span class="stat-num">120</span>
          <span class="stat-label">真实案例</span>
        </div>
        <div class="stat">
          <span class="stat-num">6</span>
          <span class="stat-label">交付阶段</span>
        </div>
      </div>
    </div>
  </section>

  <section class="chapter-list">
    <h2 class="section-title">章节目录</h2>
    <ol class="toc">
      {
        chapters.map((slug, i) => (
          <li>
            <a href={`${base}chapters/${slug}/`}>
              <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="toc-title">{titles[slug]}</span>
              <span class="toc-arrow">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="features">
    <h2 class="section-title">本站提供</h2>
    <div class="feature-grid">
      <a class="feature" href={`${base}chapters/chapter-1-rise-of-fde/`}>
        <div class="feature-icon">📖</div>
        <h3>中英对照原文</h3>
        <p>逐段并排，中文在左、英文在右，移动端自动堆叠。精读和术语对照都方便。</p>
      </a>
      <a class="feature" href={`${base}handbook/`}>
        <div class="feature-icon">✅</div>
        <h3>可执行工作手册</h3>
        <p>全书方法论整理成按交付旅程排的检查清单，每项带阈值与高危信号。</p>
      </a>
      <a class="feature" href={`${base}metrics/`}>
        <div class="feature-icon">📊</div>
        <h3>指标速查</h3>
        <p>FDE 全流程指标一页纸：TTV、NRR、毛利率、转化率，每项附参考线与警戒线。</p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, var(--c-accent-soft) 0%, var(--bg) 100%);
  }
  :root[data-theme='dark'] .hero {
    background: linear-gradient(180deg, var(--c-accent-soft) 0%, var(--bg) 100%);
  }
  .hero-inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 8vw, 5rem) 1.5rem;
    text-align: center;
  }
  .hero-eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--c-accent);
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .hero-title {
    font-size: clamp(2.5rem, 4rem + 4vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
    line-height: 1.1;
  }
  .hero-sub {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    color: var(--text-soft);
    margin: 0 auto 2rem;
    line-height: 1.7;
    max-width: 36rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .btn:hover { text-decoration: none; transform: translateY(-1px); }
  .btn-primary {
    background: var(--c-accent);
    color: #fff;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }
  .btn-ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }
  .hero-stats {
    display: flex;
    gap: 2.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .stat { display: flex; flex-direction: column; align-items: center; }
  .stat-num {
    font-size: 2rem;
    font-weight: 800;
    color: var(--c-accent);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--text-soft);
    margin-top: 0.25rem;
  }

  .chapter-list, .features {
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem;
  }
  .section-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }
  .toc {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .toc li a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    color: var(--text);
    transition: background 0.12s;
  }
  .toc li a:hover {
    background: var(--c-accent-soft);
    text-decoration: none;
  }
  .toc-num {
    font-size: 0.75rem;
    color: var(--text-soft);
    font-variant-numeric: tabular-nums;
    min-width: 1.5rem;
  }
  .toc-title { flex: 1; font-weight: 500; }
  .toc-arrow { color: var(--text-soft); opacity: 0; transition: opacity 0.12s, transform 0.12s; }
  .toc li a:hover .toc-arrow { opacity: 1; transform: translateX(3px); }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .feature {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: inherit;
    transition: border-color 0.12s, box-shadow 0.12s, transform 0.12s;
  }
  .feature:hover {
    text-decoration: none;
    border-color: var(--c-accent);
    box-shadow: 0 4px 16px var(--shadow);
    transform: translateY(-2px);
  }
  .feature-icon { font-size: 1.75rem; margin-bottom: 0.5rem; }
  .feature h3 { margin: 0 0 0.4rem; font-size: 1.05rem; }
  .feature p { margin: 0; font-size: 0.875rem; color: var(--text-soft); line-height: 1.6; }
</style>
