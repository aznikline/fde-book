---
import { getCollection } from 'astro:content';
import ParallelText from '../../components/ParallelText.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown } from '../../lib/render-md';
import { chapters, titles } from '../../lib/chapters';

export async function getStaticPaths() {
  return chapters.map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;

const zhEntry = (await getCollection('chaptersZh')).find(
  (e) => e.id === slug || e.id === `${slug}.md` || e.id.endsWith(`/${slug}.md`),
);
const enEntry = (await getCollection('chaptersEn')).find(
  (e) => e.id === slug || e.id === `${slug}.md` || e.id.endsWith(`/${slug}.md`),
);

if (!zhEntry) {
  return Astro.redirect('/404');
}

const zhBody = zhEntry.body;
const enBody = enEntry?.body ?? '';
const title = titles[slug] ?? zhEntry.data.title;
const hasEn = !!enEntry;
const zhHtml = await renderMarkdown(zhBody);

// 从中文正文提取二级标题，生成页内小节目录（锚点跳到中文列的 h2 id）
const sectionToc = [...zhBody.matchAll(/^##\s+(.+)$/gm)].map((m) => {
  const text = m[1].trim();
  // 与 rehype-slug 生成规则一致：小写、空格转横线、去标点
  const id = text
    .toLowerCase()
    .replace(/[^\w\s一-鿿-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  return { id, text };
});

const idx = chapters.indexOf(slug);
const prev = idx > 0 ? { slug: chapters[idx - 1], title: titles[chapters[idx - 1]] } : null;
const next =
  idx < chapters.length - 1
    ? { slug: chapters[idx + 1], title: titles[chapters[idx + 1]] }
    : null;
---

<BaseLayout title={title} activeSlug={slug}>
  <article class="chapter">
    <header class="chapter-head">
      <h1>{title}</h1>
      <div class="lang-badge" class:partial={!hasEn}>
        {hasEn ? '中英对照 · Bilingual' : '仅中文 · 译文待补'}
      </div>
    </header>

    {
      sectionToc.length > 0 && (
        <details class="section-toc" open>
          <summary>本章小节（{sectionToc.length}）</summary>
          <ol>
            {sectionToc.map((s) => (
              <li><a href={`#${s.id}`}>{s.text}</a></li>
            ))}
          </ol>
        </details>
      )
    }

    {
      hasEn ? (
        <ParallelText zh={zhBody} en={enBody} />
      ) : (
        <div class="zh-only" set:html={zhHtml} />
      )
    }

    <ChapterNav prev={prev} next={next} slug={slug} />
  </article>
</BaseLayout>

<style is:global>
  .chapter-head {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
    margin-bottom: 1.8rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .section-toc {
    margin: 0 0 2rem;
    padding: 0.85rem 1.1rem 1rem;
    background: var(--bg-side);
    border: 1px solid var(--border-soft);
  }
  .section-toc summary {
    cursor: pointer; font-weight: 400; font-size: 0.78rem;
    color: var(--muted);
    list-style: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-family: var(--sans);
  }
  .section-toc summary::-webkit-details-marker { display: none; }
  .section-toc summary::before { content: '▸ '; color: var(--accent); }
  .section-toc[open] summary::before { content: '▾ '; }
  .section-toc ol {
    margin: 0.8rem 0 0; padding-left: 1.25rem;
    columns: 2; column-gap: 1.5rem;
  }
  .section-toc li { margin: 0.25rem 0; break-inside: avoid; }
  .section-toc a { font-size: 0.85rem; color: var(--fg); }
  .section-toc a:hover { color: var(--accent); }
  @media (max-width: 640px) { .section-toc ol { columns: 1; } }
  .chapter-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 1rem + 2vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: var(--fg-strong);
  }
  .lang-badge {
    font-size: 0.72rem;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.2em 0.65em;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-family: var(--sans);
  }
  .lang-badge.partial {
    background: #fff3cd;
    color: #8a5a00;
  }
  :root[data-theme='dark'] .lang-badge.partial {
    background: #3a2f12;
    color: #f0c674;
  }
  .zh-only {
    font-size: 1rem;
    line-height: 1.75;
    max-width: 48rem;
  }
  .zh-only :global(h2) {
    font-size: 1.3rem;
    font-weight: 400;
    margin: 2rem 0 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-soft);
    color: var(--fg-strong);
    line-height: 1.25;
  }
  .zh-only :global(h3) {
    font-size: 1.1rem;
    font-weight: 500;
    margin: 1.5rem 0 0.5rem;
    color: var(--fg-strong);
  }
  .zh-only :global(p) { margin: 0 0 1rem; }
  .zh-only :global(blockquote) {
    border-left: 3px solid var(--border);
    padding: 0.2rem 0 0.2rem 1.1rem;
    margin: 1rem 0;
    color: var(--muted);
    font-style: italic;
  }
  .zh-only :global(ul), .zh-only :global(ol) {
    margin: 0 0 1rem; padding-left: 1.4rem;
  }
  .zh-only :global(li) { margin: 0.3rem 0; }
  .zh-only :global(code) {
    font-family: var(--mono);
    font-size: 0.86em;
    background: var(--bg-side);
    padding: 0.08em 0.3em;
    border-radius: 2px;
  }
</style>
