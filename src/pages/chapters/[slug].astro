---
import { getCollection } from 'astro:content';
import ParallelText from '../../components/ParallelText.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown } from '../../lib/render-md';
import { chapters, titles } from '../../lib/chapters';

export async function getStaticPaths() {
  return chapters.map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const base = import.meta.env.BASE_URL;

const zhEntry = (await getCollection('chaptersZh')).find(
  (e) => e.id === slug || e.id === `${slug}.md` || e.id.endsWith(`/${slug}.md`),
);
const enEntry = (await getCollection('chaptersEn')).find(
  (e) => e.id === slug || e.id === `${slug}.md` || e.id.endsWith(`/${slug}.md`),
);

if (!zhEntry) {
  return Astro.redirect(`${base}404`);
}

const zhBody = zhEntry.body;
const enBody = enEntry?.body ?? '';
const title = titles[slug] ?? zhEntry.data.title;
const hasEn = !!enEntry;
const zhHtml = await renderMarkdown(zhBody);

// 从中文正文提取二级标题，生成页内小节目录（锚点跳到中文列的 h2 id）
const sectionToc = [...zhBody.matchAll(/^##\s+(.+)$/gm)].map((m) => {
  const text = m[1].trim();
  // 与 rehype-slug 生成规则一致：小写、空格转横线、去标点
  const id = text
    .toLowerCase()
    .replace(/[^\w\s一-鿿-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  return { id, text };
});

const idx = chapters.indexOf(slug);
const prev = idx > 0 ? { slug: chapters[idx - 1], title: titles[chapters[idx - 1]] } : null;
const next =
  idx < chapters.length - 1
    ? { slug: chapters[idx + 1], title: titles[chapters[idx + 1]] }
    : null;
---

<BaseLayout title={title} activeSlug={slug}>
  <article class="chapter">
    <header class="chapter-head">
      <h1>{title}</h1>
    </header>

    {
      sectionToc.length > 0 && (
        <details class="section-toc" open>
          <summary>本章小节（{sectionToc.length}）</summary>
          <ol>
            {sectionToc.map((s) => (
              <li><a href={`#${s.id}`}>{s.text}</a></li>
            ))}
          </ol>
        </details>
      )
    }

    {
      hasEn ? (
        <ParallelText zh={zhBody} en={enBody} />
      ) : (
        <div class="zh-only" set:html={zhHtml} />
      )
    }

    <ChapterNav prev={prev} next={next} slug={slug} />
  </article>
</BaseLayout>

<style is:global>
  .chapter { max-width: 66rem; }
  .chapter-head {
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.8rem;
    padding-bottom: 1rem;
  }
  .chapter-head h1 {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--text-strong);
    line-height: 1.25;
  }
  .section-toc {
    margin: 0 0 2rem;
    padding: 0.8rem 1rem;
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: 2px;
    font-size: 0.92rem;
  }
  .section-toc summary {
    cursor: pointer; font-weight: 400; font-size: 0.9rem;
    color: var(--text);
    list-style: none;
  }
  .section-toc summary::-webkit-details-marker { display: none; }
  .section-toc summary::before { content: '▸ '; color: var(--c-accent); }
  .section-toc[open] summary::before { content: '▾ '; }
  .section-toc ol {
    margin: 0.6rem 0 0; padding-left: 1.35rem;
    columns: 2; column-gap: 1.75rem;
  }
  .section-toc li { margin: 0.25rem 0; break-inside: avoid; }
  .section-toc a { font-size: 0.88rem; color: var(--text); }
  .section-toc a:hover { color: var(--c-accent); }
  @media (max-width: 640px) { .section-toc ol { columns: 1; } }
  .zh-only {
    font-size: 0.98rem;
    line-height: 1.75;
    max-width: 44rem;
  }
  .zh-only :global(h2) {
    font-size: 1.3rem;
    font-weight: 400;
    margin: 2.4rem 0 0.9rem;
    color: var(--text-strong);
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 0.3rem;
    scroll-margin-top: 4.5rem;
  }
  .zh-only :global(h3) {
    font-size: 1.1rem;
    font-weight: 400;
    margin: 1.8rem 0 0.6rem;
    color: var(--text-strong);
    scroll-margin-top: 4.5rem;
  }
  .zh-only :global(p) { margin: 0.9rem 0; }
  .zh-only :global(blockquote) {
    margin: 0.9rem 0;
    padding-left: 1.2rem;
    border-left: 3px solid var(--border);
    color: var(--text-soft);
  }
  .zh-only :global(ul), .zh-only :global(ol) {
    margin: 0.9rem 0; padding-left: 1.4rem;
  }
  .zh-only :global(li) { margin: 0.3rem 0; }
  .zh-only :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--bg-code);
    border-radius: 2px;
    padding: 0.08rem 0.3rem;
  }
  .zh-only :global(pre) {
    background: var(--bg-code);
    border: 1px solid var(--border-soft);
    border-radius: 2px;
    padding: 1rem;
    overflow-x: auto;
  }
  .zh-only :global(pre code) { background: none; padding: 0; }
  .zh-only :global(strong) { color: var(--text-strong); }
</style>
