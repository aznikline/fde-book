---
import { getCollection } from 'astro:content';
import ParallelText from '../../components/ParallelText.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown } from '../../lib/render-md';
import { chapters, titles } from '../../lib/chapters';

export async function getStaticPaths() {
  return chapters.map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const base = import.meta.env.BASE_URL;

const zhEntry = (await getCollection('chaptersZh')).find(
  (e) => e.id === slug || e.id === `${slug}.md` || e.id.endsWith(`/${slug}.md`),
);
const enEntry = (await getCollection('chaptersEn')).find(
  (e) => e.id === slug || e.id === `${slug}.md` || e.id.endsWith(`/${slug}.md`),
);

if (!zhEntry) {
  return Astro.redirect(`${base}404`);
}

const zhBody = zhEntry.body;
const enBody = enEntry?.body ?? '';
const title = titles[slug] ?? zhEntry.data.title;
const hasEn = !!enEntry;
const zhHtml = await renderMarkdown(zhBody);

// 从中文正文提取二级标题，生成页内小节目录（锚点跳到中文列的 h2 id）
const sectionToc = [...zhBody.matchAll(/^##\s+(.+)$/gm)].map((m) => {
  const text = m[1].trim();
  // 与 rehype-slug 生成规则一致：小写、空格转横线、去标点
  const id = text
    .toLowerCase()
    .replace(/[^\w\s一-鿿-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  return { id, text };
});

const idx = chapters.indexOf(slug);
const prev = idx > 0 ? { slug: chapters[idx - 1], title: titles[chapters[idx - 1]] } : null;
const next =
  idx < chapters.length - 1
    ? { slug: chapters[idx + 1], title: titles[chapters[idx + 1]] }
    : null;
---

<BaseLayout title={title} activeSlug={slug}>
  <article class="chapter">
    <header class="chapter-head">
      <p class="chapter-eyebrow">{hasEn ? '中英对照 · Bilingual' : '仅中文 · 译文待补'}</p>
      <h1>{title}</h1>
    </header>

    {
      sectionToc.length > 0 && (
        <details class="section-toc" open>
          <summary>本章小节（{sectionToc.length}）</summary>
          <ol>
            {sectionToc.map((s) => (
              <li><a href={`#${s.id}`}>{s.text}</a></li>
            ))}
          </ol>
        </details>
      )
    }

    {
      hasEn ? (
        <ParallelText zh={zhBody} en={enBody} />
      ) : (
        <div class="zh-only" set:html={zhHtml} />
      )
    }

    <ChapterNav prev={prev} next={next} slug={slug} />
  </article>
</BaseLayout>

<style is:global>
  .chapter { max-width: 68rem; }
  .chapter-head {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.4rem;
    margin-bottom: 1.75rem;
  }
  .chapter-eyebrow {
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-accent);
    background: var(--c-accent-soft);
    border: 1px solid color-mix(in srgb, var(--c-accent) 25%, transparent);
    border-radius: 999px;
    padding: 0.28em 0.9em;
    margin: 0 0 0.85rem;
  }
  .chapter-head h1 {
    margin: 0;
    font-size: clamp(1.7rem, 1.2rem + 2.2vw, 2.6rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }
  .section-toc {
    margin: 0 0 2.25rem;
    padding: 0.9rem 1.1rem 1rem;
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .section-toc summary {
    cursor: pointer; font-weight: 700; font-size: 0.86rem;
    color: var(--text);
    list-style: none;
    font-family: var(--font-serif);
  }
  .section-toc summary::-webkit-details-marker { display: none; }
  .section-toc summary::before { content: '▸ '; color: var(--c-accent); }
  .section-toc[open] summary::before { content: '▾ '; }
  .section-toc ol {
    margin: 0.7rem 0 0; padding-left: 1.35rem;
    columns: 2; column-gap: 1.75rem;
  }
  .section-toc li { margin: 0.25rem 0; break-inside: avoid; }
  .section-toc a { font-size: 0.84rem; color: var(--text); border-bottom: 1px solid transparent; }
  .section-toc a:hover { color: var(--c-accent); border-bottom-color: var(--c-accent); }
  @media (max-width: 640px) { .section-toc ol { columns: 1; } }
  .zh-only {
    font-size: 1rem;
    line-height: 1.9;
    max-width: 44rem;
  }
  .zh-only :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    margin: 2.2rem 0 0.85rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 5rem;
  }
  .zh-only :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 1.6rem 0 0.6rem;
    scroll-margin-top: 5rem;
  }
  .zh-only :global(p) { margin: 0 0 1.05rem; }
  .zh-only :global(blockquote) {
    border-left: 3px solid var(--c-accent);
    padding: 0.6rem 1.1rem;
    margin: 1.1rem 0;
    color: var(--text-soft);
    background: var(--bg-sidebar);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .zh-only :global(ul), .zh-only :global(ol) {
    margin: 0 0 1.05rem; padding-left: 1.75rem;
  }
  .zh-only :global(li) { margin: 0.35rem 0; }
  .zh-only :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-code);
    border: 1px solid var(--border);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .zh-only :global(strong) { font-weight: 700; }
</style>
