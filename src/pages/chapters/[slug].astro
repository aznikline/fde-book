---
import { getCollection } from 'astro:content';
import ParallelText from '../../components/ParallelText.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderMarkdown } from '../../lib/render-md';
import { chapters, titles } from '../../lib/chapters';

export async function getStaticPaths() {
  return chapters.map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const base = import.meta.env.BASE_URL;

const zhEntry = (await getCollection('chaptersZh')).find(
  (e) => e.id === slug || e.id === `${slug}.md` || e.id.endsWith(`/${slug}.md`),
);
const enEntry = (await getCollection('chaptersEn')).find(
  (e) => e.id === slug || e.id === `${slug}.md` || e.id.endsWith(`/${slug}.md`),
);

if (!zhEntry) {
  return Astro.redirect(`${base}404`);
}

const zhBody = zhEntry.body;
const enBody = enEntry?.body ?? '';
const title = titles[slug] ?? zhEntry.data.title;
const hasEn = !!enEntry;
const zhHtml = await renderMarkdown(zhBody);

// 从中文正文提取二级标题，生成页内小节目录（锚点跳到中文列的 h2 id）
const sectionToc = [...zhBody.matchAll(/^##\s+(.+)$/gm)].map((m) => {
  const text = m[1].trim();
  // 与 rehype-slug 生成规则一致：小写、空格转横线、去标点
  const id = text
    .toLowerCase()
    .replace(/[^\w\s一-鿿-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  return { id, text };
});

const idx = chapters.indexOf(slug);
const prev = idx > 0 ? { slug: chapters[idx - 1], title: titles[chapters[idx - 1]] } : null;
const next =
  idx < chapters.length - 1
    ? { slug: chapters[idx + 1], title: titles[chapters[idx + 1]] }
    : null;
---

<BaseLayout title={title} activeSlug={slug}>
  <article class="chapter">
    <header class="chapter-head">
      <h1>{title}</h1>
      <div class="lang-badge" class:partial={!hasEn}>
        {hasEn ? '中英对照 · Bilingual' : '仅中文 · 译文待补'}
      </div>
    </header>

    {
      sectionToc.length > 0 && (
        <details class="section-toc" open>
          <summary>本章小节（{sectionToc.length}）</summary>
          <ol>
            {sectionToc.map((s) => (
              <li><a href={`#${s.id}`}>{s.text}</a></li>
            ))}
          </ol>
        </details>
      )
    }

    {
      hasEn ? (
        <ParallelText zh={zhBody} en={enBody} />
      ) : (
        <div class="zh-only" set:html={zhHtml} />
      )
    }

    <ChapterNav prev={prev} next={next} slug={slug} />
  </article>
</BaseLayout>

<style is:global>
  .chapter-head {
    border-bottom: 2px solid var(--c-accent);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .section-toc {
    margin: 0 0 2rem;
    padding: 0.75rem 1rem 0.85rem;
    background: var(--bg-sidebar);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .section-toc summary {
    cursor: pointer; font-weight: 600; font-size: 0.875rem;
    color: var(--text-soft);
    list-style: none;
  }
  .section-toc summary::-webkit-details-marker { display: none; }
  .section-toc summary::before { content: '▸ '; color: var(--c-accent); }
  .section-toc[open] summary::before { content: '▾ '; }
  .section-toc ol {
    margin: 0.6rem 0 0; padding-left: 1.25rem;
    columns: 2; column-gap: 1.5rem;
  }
  .section-toc li { margin: 0.2rem 0; break-inside: avoid; }
  .section-toc a { font-size: 0.82rem; color: var(--text); }
  .section-toc a:hover { color: var(--c-accent); }
  @media (max-width: 640px) { .section-toc ol { columns: 1; } }
  .chapter-head h1 {
    margin: 0;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .lang-badge {
    font-size: 0.75rem;
    background: var(--c-accent-soft);
    color: var(--c-accent);
    padding: 0.25em 0.7em;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .lang-badge.partial {
    background: #fff3cd;
    color: #92600c;
  }
  :root[data-theme='dark'] .lang-badge.partial {
    background: #3a2f12;
    color: #f0c674;
  }
  .zh-only {
    font-size: 1rem;
    line-height: 1.75;
    max-width: 48rem;
  }
  .zh-only :global(h2) {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .zh-only :global(h3) {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.5rem 0 0.5rem;
  }
  .zh-only :global(p) { margin: 0 0 1rem; }
  .zh-only :global(blockquote) {
    border-left: 3px solid var(--c-accent);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    color: var(--text-soft);
    background: var(--bg-sidebar);
    border-radius: 0 6px 6px 0;
  }
  .zh-only :global(ul), .zh-only :global(ol) {
    margin: 0 0 1rem; padding-left: 1.75rem;
  }
  .zh-only :global(li) { margin: 0.3rem 0; }
  .zh-only :global(code) {
    font-family: ui-monospace, 'SF Mono', Consolas, monospace;
    font-size: 0.875em;
    background: var(--border);
    padding: 0.15em 0.35em;
    border-radius: 4px;
  }
</style>
