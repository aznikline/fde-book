---
import { chapters, titles } from '../lib/chapters';

interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
}
const { title, description = '前线部署工程师 · 中英对照阅读 + 工作手册', activeSlug } = Astro.props;
const fullTitle = title === '首页' ? 'FDE · 前线部署工程师' : `${title} · FDE`;

// 主题初始化脚本：在首屏前确定主题，避免闪烁
const themeScript = `
(function(){
  try {
    var s = localStorage.getItem('theme');
    var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (s === 'dark' || (!s && dark)) document.documentElement.dataset.theme = 'dark';
  } catch(e){}
})();
`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <script is:inline set:html={themeScript} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Benne&family=Spectral:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  </head>
  <body data-theme-scope>
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <span class="brand-mark">FDE</span>
          <span class="brand-name">前线部署工程师</span>
        </a>
        <nav class="topnav">
          <a href="/" class:list={[{ active: !activeSlug }]}>首页</a>
          <a href="/chapters/chapter-1-rise-of-fde/" class:list={[{ active: activeSlug === 'chapter-1-rise-of-fde' }]}>原文</a>
          <a href="/handbook/" class:list={[{ active: activeSlug === 'handbook' }]}>工作手册</a>
          <a href="/metrics/" class:list={[{ active: activeSlug === 'metrics' }]}>指标速查</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" aria-label="切换主题" title="切换深浅色">
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar" id="sidebar">
        <nav aria-label="目录">
          <p class="sidebar-group-label">原文 · 中英对照</p>
          <ul class="sidebar-group">
            {
              chapters.map((c, i) => (
                <li>
                  <a href={`/chapters/${c}/`} class:list={[{ active: activeSlug === c }]}>
                    <span class="ch-num">{i + 1 < 10 ? '0' + (i + 1) : i + 1}</span>
                    {titles[c]}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="sidebar-group-label">实务</p>
          <ul class="sidebar-group">
            <li><a href="/handbook/" class:list={[{ active: activeSlug === 'handbook' }]}>FDE 工作手册</a></li>
            <li><a href="/metrics/" class:list={[{ active: activeSlug === 'metrics' }]}>指标速查</a></li>
          </ul>
          <p class="sidebar-group-label">关于</p>
          <ul class="sidebar-group">
            <li><a href="/about/" class:list={[{ active: activeSlug === 'about' }]}>关于本站</a></li>
            <li>
              <a href="https://github.com/xdash/FDE-the-Guidance-Book-of-Forward-Deployed-Engineer" target="_blank" rel="noopener">
                原书仓库 ↗
              </a>
            </li>
          </ul>
        </nav>
      </aside>
      <main class="main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>《前线部署工程师》中英对照阅读站 · 基于范冰原著</span>
        <span>知识价值在于流动</span>
      </div>
    </footer>

    <script is:inline>
      var toggle = document.getElementById('theme-toggle');
      function setTheme(dark) {
        if (dark) {
          document.documentElement.dataset.theme = 'dark';
          try { localStorage.setItem('theme', 'dark'); } catch(e){}
        } else {
          document.documentElement.dataset.theme = 'light';
          try { localStorage.setItem('theme', 'light'); } catch(e){}
        }
      }
      toggle && toggle.addEventListener('click', function () {
        var isDark = document.documentElement.dataset.theme === 'dark';
        setTheme(!isDark);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --accent: #7a00df;            /* 编辑型紫，参考 situational-awareness */
    --accent-deep: #54009e;
    --accent-soft: #f6f0fb;
    --bg: #ffffff;
    --bg-side: #faf8f4;           /* 暖白，比纯白更有纸感 */
    --bg-topbar: rgba(255, 255, 255, 0.9);
    --fg: #383838;                /* 深灰正文 */
    --fg-strong: #0c0707;         /* 近黑标题 */
    --muted: #6d6d6d;
    --border: #ddd;
    --border-soft: #eee;
    --serif: 'Benne', Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  :root[data-theme='dark'] {
    --accent: #b07cff;
    --accent-deep: #c9a3ff;
    --accent-soft: #1a1026;
    --bg: #15110f;
    --bg-side: #1c1815;
    --bg-topbar: rgba(21, 17, 15, 0.9);
    --fg: #d4cfc9;
    --fg-strong: #f5efe8;
    --muted: #9a948c;
    --border: #322c28;
    --border-soft: #28221f;
  }
  * { box-sizing: border-box; }
  html { color-scheme: light dark; scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: var(--serif);
    background: var(--bg);
    color: var(--fg);
    line-height: 1.75;
    font-size: 17px;
    font-variant-numeric: oldstyle-nums;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-deep); text-decoration: underline; text-underline-offset: 3px; }
  ::selection { background: var(--accent); color: #fff; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 5px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

  /* 顶栏 */
  .topbar {
    position: sticky; top: 0; z-index: 50;
    background: var(--bg-topbar);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .topbar-inner {
    max-width: 100rem; margin: 0 auto;
    height: 3.75rem;
    display: flex; align-items: baseline; gap: 2rem;
    padding: 0 1.5rem;
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: baseline; gap: 0.7rem; font-weight: 400; color: var(--fg-strong); }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.6rem; height: 1.6rem;
    background: var(--fg-strong); color: #fff;
    font-size: 0.62rem; font-weight: 400;
    letter-spacing: 0.02em;
    font-family: var(--sans);
  }
  .brand-name { font-size: 1.05rem; letter-spacing: 0.01em; }
  .topnav { display: flex; gap: 1.4rem; margin-left: 0.5rem; flex-wrap: wrap; }
  .topnav a {
    color: var(--fg); font-size: 0.95rem; font-weight: 400;
    padding: 0;
  }
  .topnav a:hover { color: var(--accent); text-decoration: none; }
  .topnav a.active { color: var(--accent); }
  .theme-toggle {
    margin-left: auto;
    background: none; border: 1px solid var(--border); cursor: pointer;
    width: 2.1rem; height: 2.1rem;
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  :root:not([data-theme='dark']) .icon-moon { display: block; }
  :root:not([data-theme='dark']) .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-moon { display: none; }
  :root[data-theme='dark'] .icon-sun { display: block; }

  /* 主布局 */
  .layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    max-width: 100rem; margin: 0 auto;
    min-height: calc(100vh - 3.75rem);
  }
  .sidebar {
    border-right: 1px solid var(--border);
    padding: 2rem 0.75rem;
    position: sticky; top: 3.75rem;
    height: calc(100vh - 3.75rem);
    overflow-y: auto;
    background: var(--bg);
  }
  .sidebar-group-label {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--muted); margin: 1.6rem 0.75rem 0.5rem; font-weight: 400;
  }
  .sidebar-group { list-style: none; padding: 0; margin: 0 0 0.5rem; }
  .sidebar-group li a {
    display: flex; align-items: baseline; gap: 0.6rem;
    padding: 0.25rem 0.6rem;
    color: var(--fg); font-size: 0.85rem; line-height: 1.5;
    font-family: var(--serif);
  }
  .sidebar-group li a:hover { background: var(--bg-side); text-decoration: none; color: var(--accent); }
  .sidebar-group li a.active { color: var(--accent); font-weight: 500; }
  .ch-num { font-size: 0.72rem; color: var(--muted); font-variant-numeric: oldstyle-nums; opacity: 0.7; min-width: 1.2rem; font-family: var(--mono); }
  .sidebar-group li a.active .ch-num { color: var(--accent); opacity: 1; }
  .main { padding: 2.5rem clamp(1.5rem, 3vw, 2.75rem) 4rem; min-width: 0; }

  /* 页脚 */
  .site-footer { border-top: 1px solid var(--border); background: var(--bg); }
  .footer-inner {
    max-width: 100rem; margin: 0 auto;
    padding: 1.5rem; display: flex; justify-content: space-between;
    font-size: 0.82rem; color: var(--muted); flex-wrap: wrap; gap: 0.5rem;
    font-style: italic;
  }

  @media (max-width: 880px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar {
      position: relative; top: auto; height: auto;
      border-right: none; border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem;
    }
    .topnav { display: none; }
    .brand-name { font-size: 0.95rem; }
  }
</style>
