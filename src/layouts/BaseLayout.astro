---
import { chapters, titles } from '../lib/chapters';

interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
}
const { title, description = '前线部署工程师 · 中英对照阅读 + 工作手册', activeSlug } = Astro.props;
const fullTitle = title === '首页' ? 'FDE · 前线部署工程师' : `${title} · FDE`;

// GitHub Pages 项目页的 base 路径，站内链接需带上此前缀
const base = import.meta.env.BASE_URL;

// 主题初始化脚本：在首屏前确定主题，避免闪烁
const themeScript = `
(function(){
  try {
    var s = localStorage.getItem('theme');
    var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (s === 'dark' || (!s && dark)) document.documentElement.dataset.theme = 'dark';
  } catch(e){}
})();
`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Benne&display=swap" rel="stylesheet" />
    <script is:inline set:html={themeScript} />
  </head>
  <body data-theme-scope>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={base}>前线部署工程师<small>FDE · 中英对照阅读</small></a>
        <nav class="nav">
          <a href={base} class:list={[{ active: !activeSlug }]}>首页</a>
          <a href={`${base}chapters/chapter-1-rise-of-fde/`} class:list={[{ active: activeSlug === 'chapter-1-rise-of-fde' }]}>原文</a>
          <a href={`${base}handbook/`} class:list={[{ active: activeSlug === 'handbook' }]}>工作手册</a>
          <a href={`${base}metrics/`} class:list={[{ active: activeSlug === 'metrics' }]}>指标速查</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" aria-label="切换主题" title="切换深浅色">
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar" id="sidebar">
        <nav aria-label="目录">
          <p class="sidebar-group-label">原文 · 中英对照</p>
          <ul class="sidebar-group">
            {
              chapters.map((c, i) => (
                <li>
                  <a href={`${base}chapters/${c}/`} class:list={[{ active: activeSlug === c }]}>
                    <span class="ch-num">{i + 1 < 10 ? '0' + (i + 1) : i + 1}</span>
                    {titles[c]}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="sidebar-group-label">实务</p>
          <ul class="sidebar-group">
            <li><a href={`${base}handbook/`} class:list={[{ active: activeSlug === 'handbook' }]}>FDE 工作手册</a></li>
            <li><a href={`${base}metrics/`} class:list={[{ active: activeSlug === 'metrics' }]}>指标速查</a></li>
          </ul>
          <p class="sidebar-group-label">关于</p>
          <ul class="sidebar-group">
            <li><a href={`${base}about/`} class:list={[{ active: activeSlug === 'about' }]}>关于本站</a></li>
            <li>
              <a href="https://github.com/xdash/FDE-the-Guidance-Book-of-Forward-Deployed-Engineer" target="_blank" rel="noopener">
                原书仓库 ↗
              </a>
            </li>
          </ul>
        </nav>
      </aside>
      <main class="main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>《前线部署工程师》中英对照阅读站 · 基于范冰原著</span>
        <span>知识的价值在于流动</span>
      </div>
    </footer>

    <script is:inline>
      var toggle = document.getElementById('theme-toggle');
      function setTheme(dark) {
        if (dark) {
          document.documentElement.dataset.theme = 'dark';
          try { localStorage.setItem('theme', 'dark'); } catch(e){}
        } else {
          document.documentElement.dataset.theme = 'light';
          try { localStorage.setItem('theme', 'light'); } catch(e){}
        }
      }
      toggle && toggle.addEventListener('click', function () {
        var isDark = document.documentElement.dataset.theme === 'dark';
        setTheme(!isDark);
      });
    </script>
  </body>
</html>

<style is:global>
  /* 视觉风格对齐参考站（situational-awareness）：Benne 衬线 / 白底 /
     深灰正文 / 紫色链接 / 细边框 / 大留白 / 无圆角无阴影 */
  :root {
    --c-accent: #7a00df;
    --c-accent-deep: #54009e;
    --c-accent-soft: #f5edfd;
    --c-warn: #8a5a00;
    --bg: #ffffff;
    --bg-sidebar: #faf9f7;
    --bg-topbar: #ffffff;
    --bg-code: #f5f4f1;
    --text: #383838;
    --text-strong: #0c0707;
    --text-soft: #6d6d6d;
    --border: #ddd;
    --border-soft: #eee;
    --shadow-sm: none;
    --shadow-md: none;
    --shadow-lg: none;
    --radius-sm: 2px;
    --radius: 2px;
    --radius-lg: 2px;
    --font-serif: 'Benne', Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  :root[data-theme='dark'] {
    --c-accent: #b07ae6;
    --c-accent-deep: #c79cf0;
    --c-accent-soft: #241a30;
    --c-warn: #d9a441;
    --bg: #101010;
    --bg-sidebar: #161616;
    --bg-topbar: #101010;
    --bg-code: #1b1b1b;
    --text: #c9c9c9;
    --text-strong: #f0f0f0;
    --text-soft: #8a8a8a;
    --border: #333;
    --border-soft: #2a2a2a;
  }
  :root:not([data-theme='dark']) { color-scheme: light; }
  :root[data-theme='dark'] { color-scheme: dark; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: var(--font-serif);
    background: var(--bg);
    color: var(--text);
    font-size: 17px;
    line-height: 1.75;
    font-variant-numeric: oldstyle-nums;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--c-accent); text-decoration: none; }
  a:hover { color: var(--c-accent-deep); text-decoration: underline; text-underline-offset: 3px; }
  ::selection { background: var(--c-accent); color: #fff; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 5px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--text-soft); }

  /* 顶栏（参考站 site-header） */
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.1rem 1.5rem 0.9rem;
    display: flex;
    align-items: baseline;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 400;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    color: var(--text-strong);
  }
  .brand:hover { text-decoration: none; }
  .brand small { color: var(--text-soft); font-size: 0.78rem; margin-left: 0.6rem; }
  .nav { display: flex; gap: 1.4rem; flex-wrap: wrap; }
  .nav a { color: var(--text); font-size: 0.95rem; }
  .nav a:hover { color: var(--c-accent); text-decoration: none; }
  .nav a.active { color: var(--c-accent); }
  .theme-toggle {
    margin-left: auto;
    border: 1px solid var(--border);
    background: var(--bg);
    border-radius: 2px;
    padding: 0.15rem 0.65rem;
    cursor: pointer;
    color: var(--text);
    display: flex; align-items: center; justify-content: center;
  }
  .theme-toggle:hover { border-color: var(--c-accent); color: var(--c-accent); }
  :root:not([data-theme='dark']) .icon-moon { display: block; }
  :root:not([data-theme='dark']) .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-moon { display: none; }
  :root[data-theme='dark'] .icon-sun { display: block; }

  /* 主布局：侧栏 + 正文 */
  .layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    max-width: 1100px; margin: 0 auto;
    min-height: calc(100vh - 4.5rem);
  }
  .sidebar {
    border-right: 1px solid var(--border-soft);
    padding: 1.5rem 0.75rem 2rem;
    position: sticky; top: 0;
    height: calc(100vh);
    overflow-y: auto;
    background: var(--bg-sidebar);
    font-size: 0.92rem;
  }
  .sidebar-group-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-soft);
    margin: 1.5rem 0.75rem 0.45rem;
    font-weight: 400;
  }
  .sidebar-group { list-style: none; padding: 0; margin: 0 0 0.5rem; }
  .sidebar-group li a {
    display: flex; align-items: baseline; gap: 0.5rem;
    padding: 0.28rem 0.65rem; border-radius: 2px;
    color: var(--text); font-size: 0.88rem; line-height: 1.5;
  }
  .sidebar-group li a:hover { background: var(--border-soft); text-decoration: none; color: var(--text-strong); }
  .sidebar-group li a.active { color: var(--c-accent); }
  .ch-num { font-size: 0.72rem; color: var(--text-soft); font-variant-numeric: tabular-nums; min-width: 1.3rem; font-family: var(--font-mono); }
  .sidebar-group li a.active .ch-num { color: var(--c-accent); }
  .main { padding: 2.5rem clamp(1.25rem, 3vw, 2rem) 4rem; min-width: 0; }

  /* 页脚（参考站 footer） */
  .site-footer {
    max-width: 1100px; margin: 0 auto;
    padding: 1.5rem 1.5rem 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 0.85rem;
  }
  .footer-inner {
    display: flex; justify-content: space-between;
    align-items: baseline; gap: 0.75rem; flex-wrap: wrap;
  }

  @media (max-width: 880px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar {
      position: relative; top: auto; height: auto;
      border-right: none; border-bottom: 1px solid var(--border-soft);
      padding: 0.75rem 1.25rem 1rem;
    }
    .sidebar-group { display: flex; flex-wrap: wrap; gap: 0.25rem; }
    .nav { display: none; }
    .brand small { display: none; }
  }
</style>
