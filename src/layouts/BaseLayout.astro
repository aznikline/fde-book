---
import { chapters, titles } from '../lib/chapters';

interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
}
const { title, description = '前线部署工程师 · 中英对照阅读 + 工作手册', activeSlug } = Astro.props;
const fullTitle = title === '首页' ? 'FDE · 前线部署工程师' : `${title} · FDE`;

// GitHub Pages 项目页的 base 路径，站内链接需带上此前缀
const base = import.meta.env.BASE_URL;

// 主题初始化脚本：在首屏前确定主题，避免闪烁
const themeScript = `
(function(){
  try {
    var s = localStorage.getItem('theme');
    var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (s === 'dark' || (!s && dark)) document.documentElement.dataset.theme = 'dark';
  } catch(e){}
})();
`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{fullTitle}</title>
    <script is:inline set:html={themeScript} />
  </head>
  <body data-theme-scope>
    <header class="topbar">
      <div class="topbar-inner">
        <a href={base} class="brand">
          <span class="brand-mark">FDE</span>
          <span class="brand-name">前线部署工程师</span>
        </a>
        <nav class="topnav">
          <a href={base} class:list={[{ active: !activeSlug }]}>首页</a>
          <a href={`${base}chapters/chapter-1-rise-of-fde/`} class:list={[{ active: activeSlug === 'chapter-1-rise-of-fde' }]}>原文</a>
          <a href={`${base}handbook/`} class:list={[{ active: activeSlug === 'handbook' }]}>工作手册</a>
          <a href={`${base}metrics/`} class:list={[{ active: activeSlug === 'metrics' }]}>指标速查</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" aria-label="切换主题" title="切换深浅色">
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar" id="sidebar">
        <nav aria-label="目录">
          <p class="sidebar-group-label">原文 · 中英对照</p>
          <ul class="sidebar-group">
            {
              chapters.map((c, i) => (
                <li>
                  <a href={`${base}chapters/${c}/`} class:list={[{ active: activeSlug === c }]}>
                    <span class="ch-num">{i + 1 < 10 ? '0' + (i + 1) : i + 1}</span>
                    {titles[c]}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="sidebar-group-label">实务</p>
          <ul class="sidebar-group">
            <li><a href={`${base}handbook/`} class:list={[{ active: activeSlug === 'handbook' }]}>FDE 工作手册</a></li>
            <li><a href={`${base}metrics/`} class:list={[{ active: activeSlug === 'metrics' }]}>指标速查</a></li>
          </ul>
          <p class="sidebar-group-label">关于</p>
          <ul class="sidebar-group">
            <li><a href={`${base}about/`} class:list={[{ active: activeSlug === 'about' }]}>关于本站</a></li>
            <li>
              <a href="https://github.com/xdash/FDE-the-Guidance-Book-of-Forward-Deployed-Engineer" target="_blank" rel="noopener">
                原书仓库 ↗
              </a>
            </li>
          </ul>
        </nav>
      </aside>
      <main class="main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>《前线部署工程师》中英对照阅读站 · 基于范冰原著</span>
        <span>知识价值在于流动</span>
      </div>
    </footer>

    <script is:inline>
      var toggle = document.getElementById('theme-toggle');
      function setTheme(dark) {
        if (dark) {
          document.documentElement.dataset.theme = 'dark';
          try { localStorage.setItem('theme', 'dark'); } catch(e){}
        } else {
          document.documentElement.dataset.theme = 'light';
          try { localStorage.setItem('theme', 'light'); } catch(e){}
        }
      }
      toggle && toggle.addEventListener('click', function () {
        var isDark = document.documentElement.dataset.theme === 'dark';
        setTheme(!isDark);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --c-accent: #2563eb;
    --c-accent-deep: #1d4ed8;
    --c-accent-soft: #eff5ff;
    --bg: #ffffff;
    --bg-sidebar: #fafafa;
    --bg-topbar: rgba(255, 255, 255, 0.85);
    --text: #1a1a1a;
    --text-soft: #555;
    --border: #e8e8e8;
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.06);
  }
  :root[data-theme='dark'] {
    --c-accent: #60a5fa;
    --c-accent-deep: #93c5fd;
    --c-accent-soft: #172238;
    --bg: #0f1115;
    --bg-sidebar: #14171c;
    --bg-topbar: rgba(15, 17, 21, 0.85);
    --text: #e6e6e6;
    --text-soft: #a0a0a0;
    --border: #2a2e35;
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }
  * { box-sizing: border-box; }
  html { color-scheme: light dark; scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Noto Sans CJK SC', 'Source Han Sans SC',
      'Microsoft YaHei', Roboto, Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  a { color: var(--c-accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  ::selection { background: var(--c-accent); color: #fff; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 5px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--text-soft); }

  /* 顶栏 */
  .topbar {
    position: sticky; top: 0; z-index: 50;
    background: var(--bg-topbar);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .topbar-inner {
    max-width: 100rem; margin: 0 auto;
    height: 3.5rem;
    display: flex; align-items: center; gap: 1.5rem;
    padding: 0 1.25rem;
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 800; color: var(--text); }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.75rem; height: 1.75rem;
    background: var(--c-accent); color: #fff;
    border-radius: 6px; font-size: 0.7rem; font-weight: 800;
    letter-spacing: 0.02em;
  }
  .brand-name { font-size: 1rem; letter-spacing: 0.01em; }
  .topnav { display: flex; gap: 0.25rem; margin-left: 0.5rem; }
  .topnav a {
    padding: 0.4rem 0.75rem; border-radius: 6px;
    font-size: 0.875rem; color: var(--text-soft); font-weight: 500;
  }
  .topnav a:hover { background: var(--border); text-decoration: none; }
  .topnav a.active { color: var(--c-accent); background: var(--c-accent-soft); }
  .theme-toggle {
    margin-left: auto;
    background: none; border: 1px solid var(--border); cursor: pointer;
    width: 2.25rem; height: 2.25rem; border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-soft);
  }
  .theme-toggle:hover { background: var(--border); }
  :root:not([data-theme='dark']) .icon-moon { display: block; }
  :root:not([data-theme='dark']) .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-moon { display: none; }
  :root[data-theme='dark'] .icon-sun { display: block; }

  /* 主布局 */
  .layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    max-width: 100rem; margin: 0 auto;
    min-height: calc(100vh - 3.5rem);
  }
  .sidebar {
    border-right: 1px solid var(--border);
    padding: 1.5rem 0.75rem;
    position: sticky; top: 3.5rem;
    height: calc(100vh - 3.5rem);
    overflow-y: auto;
    background: var(--bg-sidebar);
  }
  .sidebar-group-label {
    font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--text-soft); margin: 1.25rem 0.75rem 0.4rem; font-weight: 700;
  }
  .sidebar-group { list-style: none; padding: 0; margin: 0 0 0.5rem; }
  .sidebar-group li a {
    display: flex; align-items: baseline; gap: 0.5rem;
    padding: 0.3rem 0.6rem; border-radius: 5px;
    color: var(--text-soft); font-size: 0.82rem; line-height: 1.4;
  }
  .sidebar-group li a:hover { background: var(--border); text-decoration: none; color: var(--text); }
  .sidebar-group li a.active { background: var(--c-accent-soft); color: var(--c-accent); font-weight: 600; }
  .ch-num { font-size: 0.68rem; color: var(--text-soft); font-variant-numeric: tabular-nums; opacity: 0.7; min-width: 1.2rem; }
  .sidebar-group li a.active .ch-num { color: var(--c-accent); opacity: 1; }
  .main { padding: 1.5rem clamp(1rem, 3vw, 2.75rem) 4rem; min-width: 0; }

  /* 页脚 */
  .site-footer { border-top: 1px solid var(--border); background: var(--bg-sidebar); }
  .footer-inner {
    max-width: 100rem; margin: 0 auto;
    padding: 1.25rem; display: flex; justify-content: space-between;
    font-size: 0.75rem; color: var(--text-soft); flex-wrap: wrap; gap: 0.5rem;
  }

  @media (max-width: 880px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar {
      position: relative; top: auto; height: auto;
      border-right: none; border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem;
    }
    .topnav { display: none; }
    .brand-name { font-size: 0.9rem; }
  }
</style>
