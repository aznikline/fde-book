---
import { parseToBlocks, pairBlocks } from '../lib/parallel';

interface Props {
  zh: string; // 中文 markdown 原文
  en: string; // 英文 markdown 译文
}

const { zh, en } = Astro.props;

const zhBlocks = await parseToBlocks(zh);
const enBlocks = await parseToBlocks(en);
const pairs = pairBlocks(zhBlocks, enBlocks);
---

<div class="parallel">
  {
    pairs.map((p, i) => (
      <div class={`pair${p.aligned ? '' : ' pair--unaligned'}`} data-index={i}>
        <div class="pair__zh" set:html={p.zh ?? '<p class="missing">（中文缺）</p>'} />
        <div class="pair__en" set:html={p.en ?? '<p class="missing">（English missing）</p>'} />
      </div>
    ))
  }
</div>

<style>
  .parallel {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  /* 未对齐块加警示底色，方便译者自查 */
  .pair--unaligned {
    background: var(--c-warn);
    box-shadow: inset 3px 0 0 var(--c-warn);
    padding: 0.6rem 0.9rem;
    border-radius: 2px;
    background: color-mix(in srgb, var(--c-warn) 7%, transparent);
  }
  .pair__zh,
  .pair__en {
    font-size: 0.98rem;
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  .pair__zh :global(h1),
  .pair__en :global(h1) {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 0.9rem;
    color: var(--text-strong);
  }
  .pair__zh :global(h2),
  .pair__en :global(h2) {
    font-size: 1.3rem;
    font-weight: 400;
    margin: 2.4rem 0 0.9rem;
    color: var(--text-strong);
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 0.3rem;
  }
  .pair__zh :global(h3),
  .pair__en :global(h3) {
    font-size: 1.1rem;
    font-weight: 400;
    margin: 1.8rem 0 0.6rem;
    color: var(--text-strong);
  }
  .pair__zh :global(p),
  .pair__en :global(p) {
    margin: 0.9rem 0;
  }
  .pair__zh :global(p:first-of-type),
  .pair__en :global(p:first-of-type) {
    margin-top: 0;
  }
  .pair__zh :global(blockquote),
  .pair__en :global(blockquote) {
    margin: 0.9rem 0;
    padding-left: 1.2rem;
    border-left: 3px solid var(--border);
    color: var(--text-soft);
  }
  .pair__zh :global(ul),
  .pair__zh :global(ol),
  .pair__en :global(ul),
  .pair__en :global(ol) {
    margin: 0.9rem 0;
    padding-left: 1.4rem;
  }
  .pair__zh :global(li),
  .pair__en :global(li) {
    margin: 0.3rem 0;
  }
  .pair__zh :global(code),
  .pair__en :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--bg-code);
    border-radius: 2px;
    padding: 0.08rem 0.3rem;
  }
  .pair__zh :global(pre),
  .pair__en :global(pre) {
    background: var(--bg-code);
    border: 1px solid var(--border-soft);
    border-radius: 2px;
    padding: 1rem;
    overflow-x: auto;
  }
  .pair__zh :global(pre code),
  .pair__en :global(pre code) {
    background: none;
    padding: 0;
  }
  .pair__zh :global(table),
  .pair__en :global(table) {
    border-collapse: collapse;
    font-size: 0.88rem;
    margin: 0.9rem 0;
  }
  .pair__zh :global(th),
  .pair__zh :global(td),
  .pair__en :global(th),
  .pair__en :global(td) {
    border: 1px solid var(--border);
    padding: 0.35rem 0.65rem;
  }
  .pair__zh :global(strong),
  .pair__en :global(strong) {
    color: var(--text-strong);
  }
  .pair__en :global(.missing),
  .pair__zh :global(.missing) {
    color: var(--c-warn);
    font-style: italic;
  }

  /* 移动端：堆叠为上下，中文在上英文在下 */
  @media (max-width: 880px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .pair__zh {
      border-bottom: 1px solid var(--border-soft);
      padding-bottom: 1rem;
    }
  }
</style>
