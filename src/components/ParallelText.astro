---
import { parseToBlocks, pairBlocks } from '../lib/parallel';

interface Props {
  zh: string; // 中文 markdown 原文
  en: string; // 英文 markdown 译文
}

const { zh, en } = Astro.props;

const zhBlocks = await parseToBlocks(zh);
const enBlocks = await parseToBlocks(en);
const pairs = pairBlocks(zhBlocks, enBlocks);
---

<div class="parallel">
  {
    pairs.map((p, i) => (
      <div class={`pair${p.aligned ? '' : ' pair--unaligned'}`} data-index={i}>
        <div class="pair__col">
          <span class="pair__lang">中文</span>
          <div class="pair__zh" set:html={p.zh ?? '<p class="missing">（中文缺）</p>'} />
        </div>
        <div class="pair__col">
          <span class="pair__lang pair__lang--en">English</span>
          <div class="pair__en" set:html={p.en ?? '<p class="missing">（English missing）</p>'} />
        </div>
      </div>
    ))
  }
</div>

<style>
  .parallel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }
  .pair:last-child {
    border-bottom: none;
  }
  /* 未对齐块加警示边框，方便译者自查 */
  .pair--unaligned {
    background: var(--c-warn);
    box-shadow: inset 3px 0 0 var(--c-warn);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-warn) 7%, transparent);
  }
  .pair__lang {
    display: inline-flex;
    align-items: center;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.12em 0.7em;
    margin-bottom: 0.6rem;
    background: var(--bg-sidebar);
  }
  .pair__lang--en {
    color: var(--c-accent);
    border-color: color-mix(in srgb, var(--c-accent) 30%, transparent);
    background: var(--c-accent-soft);
  }
  .pair__zh,
  .pair__en {
    font-size: 1rem;
    line-height: 1.85;
    overflow-wrap: break-word;
  }
  .pair__zh :global(h1),
  .pair__en :global(h1) {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }
  .pair__zh :global(h2),
  .pair__en :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.28rem;
    font-weight: 700;
    margin: 1.4rem 0 0.6rem;
    padding-top: 1.4rem;
    border-top: 1px dashed var(--border-strong);
  }
  .pair__zh :global(h3),
  .pair__en :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.1rem 0 0.45rem;
  }
  .pair__zh :global(p),
  .pair__en :global(p) {
    margin: 0 0 0.7rem;
  }
  .pair__zh :global(p:last-child),
  .pair__en :global(p:last-child) {
    margin-bottom: 0;
  }
  .pair__zh :global(blockquote),
  .pair__en :global(blockquote) {
    border-left: 3px solid var(--c-accent);
    padding: 0.3rem 0.85rem;
    margin: 0 0 0.7rem;
    color: var(--text-soft);
    background: var(--bg-sidebar);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: normal;
  }
  .pair__zh :global(ul),
  .pair__zh :global(ol),
  .pair__en :global(ul),
  .pair__en :global(ol) {
    margin: 0 0 0.7rem;
    padding-left: 1.5rem;
  }
  .pair__zh :global(li),
  .pair__en :global(li) {
    margin: 0.25rem 0;
  }
  .pair__zh :global(code),
  .pair__en :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-code);
    border: 1px solid var(--border);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .pair__zh :global(a),
  .pair__en :global(a) {
    color: var(--c-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--c-accent) 35%, transparent);
  }
  .pair__zh :global(a:hover),
  .pair__en :global(a:hover) {
    text-decoration: none;
    border-bottom-color: var(--c-accent);
  }
  .pair__zh :global(strong),
  .pair__en :global(strong) {
    font-weight: 700;
  }
  .pair__en :global(.missing),
  .pair__zh :global(.missing) {
    color: var(--c-warn);
    font-style: italic;
    opacity: 0.85;
  }
  /* 中文段落比英文略小，因为中文信息密度高、字形宽；保持两列视觉平衡 */
  .pair__zh {
    font-size: 0.965rem;
    line-height: 1.9;
  }
  .pair__en {
    font-size: 1rem;
    line-height: 1.75;
  }

  /* 移动端：堆叠为上下，中文在上英文在下 */
  @media (max-width: 880px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
    .pair__zh {
      font-size: 1rem;
      border-bottom: 1px dashed var(--border-strong);
      padding-bottom: 0.9rem;
    }
    .pair__en {
      padding-top: 0.15rem;
    }
  }
</style>
