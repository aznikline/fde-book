---
import { parseToBlocks, pairBlocks } from '../lib/parallel';

interface Props {
  zh: string; // 中文 markdown 原文
  en: string; // 英文 markdown 译文
}

const { zh, en } = Astro.props;

const zhBlocks = await parseToBlocks(zh);
const enBlocks = await parseToBlocks(en);
const pairs = pairBlocks(zhBlocks, enBlocks);
---

<div class="parallel">
  {
    pairs.map((p, i) => (
      <div class={`pair${p.aligned ? '' : ' pair--unaligned'}`} data-index={i}>
        <div class="pair__pane pair__zh">
          <span class="pane-label">中文</span>
          <div class="pane-body" set:html={p.zh ?? '<p class="missing">（中文缺）</p>'} />
        </div>
        <div class="pair__pane pair__en">
          <span class="pane-label">English</span>
          <div class="pane-body" set:html={p.en ?? '<p class="missing">（English missing）</p>'} />
        </div>
      </div>
    ))
  }
</div>

<style>
  .parallel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  /* 未对齐块加警示边框，方便译者自查 */
  .pair--unaligned {
    background: #fffbe6;
    box-shadow: inset 3px 0 0 #d4a017;
    padding: 0.5rem 0.75rem;
  }
  :root[data-theme='dark'] .pair--unaligned {
    background: #2a2410;
  }
  .pair__pane {
    border-top: 3px solid var(--fg-strong);
    padding-top: 0.9rem;
  }
  .pane-label {
    display: block;
    font-size: 0.7rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 0.8rem;
    font-family: var(--sans);
  }
  .pane-body {
    font-size: 0.98rem;
    line-height: 1.7;
    overflow-wrap: break-word;
  }
  .pane-body :global(h1) {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 0.75rem;
    color: var(--fg-strong);
    line-height: 1.2;
  }
  .pane-body :global(h2) {
    font-size: 1.25rem;
    font-weight: 400;
    margin: 1.5rem 0 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-soft);
    color: var(--fg-strong);
    line-height: 1.25;
  }
  .pane-body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .pane-body :global(h3) {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 1.1rem 0 0.4rem;
    color: var(--fg-strong);
  }
  .pane-body :global(p) {
    margin: 0 0 0.85rem;
  }
  .pane-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .pane-body :global(blockquote) {
    border-left: 3px solid var(--border);
    padding: 0.2rem 0 0.2rem 1.1rem;
    margin: 0.9rem 0;
    color: var(--muted);
    font-style: italic;
  }
  .pane-body :global(blockquote p) {
    margin: 0.3rem 0;
  }
  .pane-body :global(ul),
  .pane-body :global(ol) {
    margin: 0 0 0.85rem;
    padding-left: 1.4rem;
  }
  .pane-body :global(li) {
    margin: 0.3rem 0;
  }
  .pane-body :global(code) {
    font-family: var(--mono);
    font-size: 0.86em;
    background: var(--bg-side);
    padding: 0.08rem 0.3rem;
    border-radius: 2px;
  }
  .pane-body :global(pre) {
    font-family: var(--mono);
    background: var(--bg-side);
    border: 1px solid var(--border-soft);
    padding: 0.9rem;
    overflow-x: auto;
    white-space: pre-wrap;
    font-size: 0.85em;
  }
  .pane-body :global(a) {
    color: var(--accent);
    text-decoration: none;
  }
  .pane-body :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pane-body :global(strong) {
    color: var(--fg-strong);
    font-weight: 500;
  }
  .pane-body :global(.missing) {
    color: #d33;
    font-style: italic;
    opacity: 0.7;
  }
  /* 中文段落略小，信息密度高；英文略大，保持两列视觉平衡 */
  .pair__zh .pane-body {
    font-size: 0.95rem;
    line-height: 1.78;
  }
  .pair__en .pane-body {
    font-size: 1rem;
    line-height: 1.68;
  }

  /* 移动端：堆叠为上下，中文在上英文在下 */
  @media (max-width: 880px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .pair__zh .pane-body {
      font-size: 1rem;
    }
    .pair__zh {
      border-bottom: 1px dashed var(--border-soft);
      padding-bottom: 0.75rem;
    }
  }
</style>
