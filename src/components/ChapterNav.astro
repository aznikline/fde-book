---
// 上下章导航组件
interface NavItem {
  slug: string;
  title: string;
}
interface Props {
  prev: NavItem | null;
  next: NavItem | null;
  slug: string;
}
const { prev, next, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="chapter-nav" aria-label="章节导航">
  {prev ? (
    <a class="nav-card nav-card--prev" href={`${base}chapters/${prev.slug}/`}>
      <span class="nav-label">← 上一章 / Previous</span>
      <span class="nav-title">{prev.title}</span>
    </a>
  ) : (
    <span class="nav-card nav-card--placeholder" />
  )}
  <a class="nav-card nav-card--handbook" href={`${base}handbook/`}>
    <span class="nav-label">本章实操清单</span>
    <span class="nav-title">→ 工作手册</span>
  </a>
  {next ? (
    <a class="nav-card nav-card--next" href={`${base}chapters/${next.slug}/`}>
      <span class="nav-label">下一章 / Next →</span>
      <span class="nav-title">{next.title}</span>
    </a>
  ) : (
    <span class="nav-card nav-card--placeholder" />
  )}
</nav>

<style>
  .chapter-nav {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.85rem;
    margin-top: 3.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .nav-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .nav-card--prev {
    text-align: left;
  }
  .nav-card--next {
    text-align: right;
    align-items: flex-end;
  }
  .nav-card--handbook {
    text-align: center;
    align-items: center;
    background: var(--c-accent-soft);
    border-color: color-mix(in srgb, var(--c-accent) 25%, transparent);
  }
  .nav-card--handbook:hover {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-md);
  }
  .nav-card--placeholder {
    visibility: hidden;
  }
  .nav-label {
    font-size: 0.72rem;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .nav-card--handbook .nav-label {
    color: var(--c-accent);
  }
  .nav-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.95rem;
  }
  @media (max-width: 720px) {
    .chapter-nav {
      grid-template-columns: 1fr;
    }
    .nav-card--next {
      text-align: left;
      align-items: flex-start;
    }
    .nav-card--placeholder {
      display: none;
    }
  }
</style>
