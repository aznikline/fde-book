---
// 上下章导航组件
interface NavItem {
  slug: string;
  title: string;
}
interface Props {
  prev: NavItem | null;
  next: NavItem | null;
  slug: string;
}
const { prev, next, slug } = Astro.props;
---

<nav class="chapter-nav" aria-label="章节导航">
  {prev ? (
    <a class="nav-card nav-card--prev" href={`/chapters/${prev.slug}/`}>
      <span class="nav-label">← 上一章 / Previous</span>
      <span class="nav-title">{prev.title}</span>
    </a>
  ) : (
    <span class="nav-card nav-card--placeholder" />
  )}
  <a class="nav-card nav-card--handbook" href={`/handbook/`}>
    <span class="nav-label">本章实操清单</span>
    <span class="nav-title">→ 工作手册</span>
  </a>
  {next ? (
    <a class="nav-card nav-card--next" href={`/chapters/${next.slug}/`}>
      <span class="nav-label">下一章 / Next →</span>
      <span class="nav-title">{next.title}</span>
    </a>
  ) : (
    <span class="nav-card nav-card--placeholder" />
  )}
</nav>

<style>
  .chapter-nav {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1px;
    margin-top: 3rem;
    background: var(--border-soft);
    border: 1px solid var(--border-soft);
    border-top: 3px solid var(--fg-strong);
  }
  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s, color 0.15s;
  }
  .nav-card:hover {
    background: var(--bg-side);
    text-decoration: none;
  }
  .nav-card--prev {
    text-align: left;
  }
  .nav-card--next {
    text-align: right;
    align-items: flex-end;
  }
  .nav-card--handbook {
    text-align: center;
    align-items: center;
  }
  .nav-card--placeholder {
    visibility: hidden;
  }
  .nav-label {
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-family: var(--sans);
  }
  .nav-card--handbook .nav-label {
    color: var(--accent);
  }
  .nav-card:hover .nav-label {
    color: var(--accent);
  }
  .nav-title {
    font-weight: 400;
    font-size: 0.92rem;
    color: var(--fg-strong);
  }
  .nav-card:hover .nav-title {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .chapter-nav {
      grid-template-columns: 1fr;
    }
    .nav-card--next {
      text-align: left;
      align-items: flex-start;
    }
    .nav-card--placeholder {
      display: none;
    }
  }
</style>
