---
// 上下章导航组件
interface NavItem {
  slug: string;
  title: string;
}
interface Props {
  prev: NavItem | null;
  next: NavItem | null;
  slug: string;
}
const { prev, next, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="chapter-nav" aria-label="章节导航">
  <div class="chapter-nav-group">
    {prev ? (
      <a class="nav-card" href={`${base}chapters/${prev.slug}/`}>
        <span class="nav-label">← 上一章</span>
        <span class="nav-title">{prev.title}</span>
      </a>
    ) : (
      <span class="nav-card nav-card--empty" />
    )}
    {next ? (
      <a class="nav-card" href={`${base}chapters/${next.slug}/`}>
        <span class="nav-label">下一章 →</span>
        <span class="nav-title">{next.title}</span>
      </a>
    ) : (
      <span class="nav-card nav-card--empty" />
    )}
  </div>
  <a class="nav-card nav-card--handbook" href={`${base}handbook/`}>
    <span class="nav-label">本章实操清单</span>
    <span class="nav-title">工作手册</span>
  </a>
</nav>

<style>
  .chapter-nav {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .chapter-nav-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    text-decoration: none;
    color: var(--text);
    background: var(--bg);
  }
  .nav-card:hover { border-color: var(--c-accent); color: var(--c-accent); text-decoration: none; }
  .nav-card--empty { visibility: hidden; }
  .nav-label {
    font-size: 0.72rem;
    color: var(--text-soft);
    letter-spacing: 0.04em;
  }
  .nav-card:hover .nav-label { color: var(--c-accent); }
  .nav-title { font-size: 0.95rem; color: var(--text-strong); }
  .nav-card:hover .nav-title { color: var(--c-accent); }
  @media (max-width: 720px) {
    .nav-card--empty { display: none; }
  }
</style>
